# Pipeline GitLab CI — traduction fidèle de .github/workflows/ci.yml (Option 2 ADR-001 :
# monorepo intact + jobs conditionnés par `changes:`).
#
# Ce fichier est livré en `.gitlab-ci.yml.example` pour NE PAS être actif sur GitHub.
# Sur GitLab : `git mv .gitlab-ci.yml.example .gitlab-ci.yml` (voir GITLAB-BOOTSTRAP.md §3).
#
# Correspondance exacte des étapes avec ci.yml (JDK 21 temurin, génération de clés RSA de test,
# mvn verify sous H2, gates Testcontainers PG, tsc/vitest/build, flutter analyze/test/apk).

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"
    - if: $CI_COMMIT_TAG

default:
  interruptible: true

# ------------------------------------------------------------------ Backend (H2, profil test)
backend:h2:
  stage: test
  image: maven:3.9-eclipse-temurin-21
  services:
    - redis:7-alpine
  variables:
    REDIS_URL: redis://redis:6379
    JWT_PRIVATE_KEY_PATH: "$CI_PROJECT_DIR/keys/private.pem"
    JWT_PUBLIC_KEY_PATH: "$CI_PROJECT_DIR/keys/public.pem"
  cache:
    key: m2-$CI_COMMIT_REF_SLUG
    paths: [ .m2/repository ]
  rules:
    - changes: [ backend/**/*, pom.xml, "**/*.sql" ]
    - if: $CI_COMMIT_BRANCH == "main"
  before_script:
    - mkdir -p keys
    - openssl genpkey -algorithm RSA -out keys/private.pem -pkeyopt rsa_keygen_bits:2048
    - openssl pkey -in keys/private.pem -pubout -out keys/public.pem
  script:
    - cd backend && mvn -B -Dmaven.repo.local="$CI_PROJECT_DIR/.m2/repository" verify
  artifacts:
    when: always
    expire_in: 14 days
    paths: [ backend/target/surefire-reports/ ]

# ---------------------------------------------------------- Backend gates PostgreSQL (Testcontainers)
backend:pg-gates:
  stage: test
  image: maven:3.9-eclipse-temurin-21
  services:
    - docker:27-dind            # Testcontainers a besoin du démon Docker
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
    TESTCONTAINERS_RYUK_DISABLED: "true"
    JWT_PRIVATE_KEY_PATH: "$CI_PROJECT_DIR/keys/private.pem"
    JWT_PUBLIC_KEY_PATH: "$CI_PROJECT_DIR/keys/public.pem"
  cache:
    key: m2-$CI_COMMIT_REF_SLUG
    paths: [ .m2/repository ]
  rules:
    - changes: [ backend/**/*, "**/*.sql", pom.xml ]
    - if: $CI_COMMIT_BRANCH == "main"
  before_script:
    - mkdir -p keys
    - openssl genpkey -algorithm RSA -out keys/private.pem -pkeyopt rsa_keygen_bits:2048
    - openssl pkey -in keys/private.pem -pubout -out keys/public.pem
  script:
    - cd backend && mvn -B -Dmaven.repo.local="$CI_PROJECT_DIR/.m2/repository" test
        -Dtest='FlywayMigrationChainPostgreSqlTest,EventTableContractTest'
  artifacts:
    when: always
    expire_in: 14 days
    paths: [ backend/target/surefire-reports/ ]

# ------------------------------------------------------------------------- Frontend (tsc/vitest/build)
frontend:
  stage: test
  image: node:23
  variables:
    VITE_API_URL: https://discipolat-api.onrender.com
  cache:
    key: npm-$CI_COMMIT_REF_SLUG
    paths: [ frontend/node_modules ]
  rules:
    - changes: [ frontend/**/* ]
    - if: $CI_COMMIT_BRANCH == "main"
  script:
    - cd frontend && npm ci
    - npx tsc --noEmit
    - npx vitest run --reporter=default --reporter=junit --outputFile.junit=./test-results/junit.xml
    - npm run build
  artifacts:
    when: always
    expire_in: 14 days
    paths: [ frontend/test-results/ ]

# ---------------------------------------------------------------------------- Mobile (Flutter analyze/test/apk)
mobile:
  stage: test
  image: ghcr.io/cirruslabs/flutter:3.35.6     # image Flutter communautaire
  rules:
    - changes: [ mobile/**/*, pubspec.yaml ]
    - if: $CI_COMMIT_BRANCH == "main"
  script:
    - cd mobile && flutter pub get
    - flutter analyze --no-pub --no-fatal-warnings --no-fatal-infos
    - flutter test --no-pub --file-reporter json:flutter-test-report.json
    - flutter build apk --debug --no-pub
  artifacts:
    when: always
    expire_in: 14 days
    paths: [ mobile/flutter-test-report.json ]

# ------------------------------------------------------------------------------- Build image backend
docker:backend:
  stage: build
  image: docker:27
  services: [ docker:27-dind ]
  needs: [ backend:h2, backend:pg-gates, frontend, mobile ]
  rules:
    - if: $CI_COMMIT_BRANCH == "main"
  before_script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
  script:
    # JAR reconstruit ici (le workspace n'a pas target/)
    - apk add --no-cache maven openjdk21 openssl
    - mkdir -p keys && openssl genpkey -algorithm RSA -out keys/private.pem -pkeyopt rsa_keygen_bits:2048
    - openssl pkey -in keys/private.pem -pubout -out keys/public.pem
    - cd backend && mvn -B package -DskipTests -q
    - docker build -t "$CI_REGISTRY_IMAGE/backend:latest" -t "$CI_REGISTRY_IMAGE/backend:$CI_COMMIT_SHA" .
    - docker push "$CI_REGISTRY_IMAGE/backend:latest"
    - docker push "$CI_REGISTRY_IMAGE/backend:$CI_COMMIT_SHA"

# ------------------------------------------------------------------------ Déploiement Render (auto, main)
deploy:render:
  stage: deploy
  image: curlimages/curl:latest
  needs: [ docker:backend ]
  rules:
    - if: $CI_COMMIT_BRANCH == "main"
  script:
    - |
      if [ -z "$RENDER_API_KEY" ] || [ -z "$RENDER_API_SERVICE_ID" ]; then
        echo "Secrets RENDER_API_KEY / RENDER_API_SERVICE_ID manquants (Settings → CI/CD → Variables)."; exit 1
      fi
      HTTP=$(curl -s -o /tmp/r.json -w '%{http_code}' -X POST \
        "https://api.render.com/v1/services/$RENDER_API_SERVICE_ID/deploys" \
        -H "Authorization: Bearer $RENDER_API_KEY" -H "Content-Type: application/json" \
        -d '{"clearCache":"do_not_clear"}')
      echo "Render HTTP $HTTP"; cat /tmp/r.json
      [ "$HTTP" = "201" ] || [ "$HTTP" = "202" ] || exit 1

stages: [ test, build, deploy ]
