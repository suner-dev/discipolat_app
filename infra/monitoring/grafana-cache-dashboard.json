{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Vue d'ensemble du cache",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Cache Hit Ratio Global",
      "type": "stat",
      "description": "Ratio global de hits sur tous les caches combinés",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{result=\"hit\"}[5m])) / sum(rate(cache_gets_total[5m])) * 100",
          "legendFormat": "Hit Ratio Global",
          "interval": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Requêtes par seconde (throughput)",
      "type": "stat",
      "description": "Nombre total de requêtes cache par seconde (hits + misses)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total[5m]))",
          "legendFormat": "Throughput"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Hits (cumul)",
      "type": "stat",
      "description": "Nombre total de hits depuis le dernier redémarrage",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(cache_gets_total{result=\"hit\"})",
          "legendFormat": "Total Hits"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Misses (cumul)",
      "type": "stat",
      "description": "Nombre total de misses depuis le dernier redémarrage",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short",
          "decimals": 0
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(cache_gets_total{result=\"miss\"})",
          "legendFormat": "Total Misses"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ratio Hit/Miss",
      "type": "stat",
      "description": "Ratio hits / misses (valeur > 1 = healthy, > 5 = optimal)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 5 }
            ]
          },
          "unit": "none",
          "decimals": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(cache_gets_total{result=\"hit\"}) / sum(cache_gets_total{result=\"miss\"})",
          "legendFormat": "Hit/Miss Ratio"
        }
      ]
    },
    {
      "id": 7,
      "title": "Nombre de caches actifs",
      "type": "stat",
      "description": "Nombre de caches configurés avec des métriques",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "count(cache_gets_total)",
          "legendFormat": "Caches actifs"
        }
      ]
    },

    {
      "id": 8,
      "title": "Hit Ratio par Cache",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "evaluationScores",
      "type": "stat",
      "description": "Hit ratio pour le cache des scores d'évaluation",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent", "min": 0, "max": 100, "decimals": 1
        }
      },
      "gridPos": { "h": 3, "w": 8, "x": 0, "y": 6 },
      "options": {
        "colorMode": "background", "graphMode": "sparkline",
        "justifyMode": "auto", "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum by (cache) (rate(cache_gets_total{cache=\"evaluationScores\",result=\"hit\"}[5m])) / sum by (cache) (rate(cache_gets_total{cache=\"evaluationScores\"}[5m])) * 100",
          "legendFormat": "Hit Ratio"
        }
      ]
    },
    {
      "id": 10,
      "title": "dashboardKpi",
      "type": "stat",
      "description": "Hit ratio pour le cache des KPI dashboard",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent", "min": 0, "max": 100, "decimals": 1
        }
      },
      "gridPos": { "h": 3, "w": 8, "x": 8, "y": 6 },
      "options": {
        "colorMode": "background", "graphMode": "sparkline",
        "justifyMode": "auto", "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum by (cache) (rate(cache_gets_total{cache=\"dashboardKpi\",result=\"hit\"}[5m])) / sum by (cache) (rate(cache_gets_total{cache=\"dashboardKpi\"}[5m])) * 100",
          "legendFormat": "Hit Ratio"
        }
      ]
    },
    {
      "id": 11,
      "title": "dashboardTrends",
      "type": "stat",
      "description": "Hit ratio pour le cache des tendances dashboard",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent", "min": 0, "max": 100, "decimals": 1
        }
      },
      "gridPos": { "h": 3, "w": 8, "x": 16, "y": 6 },
      "options": {
        "colorMode": "background", "graphMode": "sparkline",
        "justifyMode": "auto", "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum by (cache) (rate(cache_gets_total{cache=\"dashboardTrends\",result=\"hit\"}[5m])) / sum by (cache) (rate(cache_gets_total{cache=\"dashboardTrends\"}[5m])) * 100",
          "legendFormat": "Hit Ratio"
        }
      ]
    },

    {
      "id": 12,
      "title": "Performance dans le temps",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 13,
      "title": "Hit Ratio par Cache (série temporelle)",
      "type": "timeseries",
      "description": "Évolution du hit ratio pour chaque cache sur les dernières 24h",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "Hit Ratio (%)", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line",
            "fillOpacity": 15, "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "area" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 }, { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent", "min": 0, "max": 100, "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "options": {
        "legend": {
          "calcs": ["last", "mean", "max", "min"],
          "displayMode": "table", "placement": "bottom", "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=\"evaluationScores\",result=\"hit\"}[5m])) / sum(rate(cache_gets_total{cache=\"evaluationScores\"}[5m])) * 100",
          "legendFormat": "evaluationScores"
        },
        {
          "expr": "sum(rate(cache_gets_total{cache=\"dashboardKpi\",result=\"hit\"}[5m])) / sum(rate(cache_gets_total{cache=\"dashboardKpi\"}[5m])) * 100",
          "legendFormat": "dashboardKpi"
        },
        {
          "expr": "sum(rate(cache_gets_total{cache=\"dashboardTrends\",result=\"hit\"}[5m])) / sum(rate(cache_gets_total{cache=\"dashboardTrends\"}[5m])) * 100",
          "legendFormat": "dashboardTrends"
        }
      ]
    },
    {
      "id": 14,
      "title": "Requêtes par seconde par Cache",
      "type": "timeseries",
      "description": "Throughput par cache (hits + misses par seconde)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "Requêtes/s", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line",
            "fillOpacity": 20, "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": true,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "reqps", "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "options": {
        "legend": {
          "calcs": ["last", "mean", "max"],
          "displayMode": "table", "placement": "bottom", "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "sum(rate(cache_gets_total{cache=\"evaluationScores\"}[5m]))", "legendFormat": "evaluationScores" },
        { "expr": "sum(rate(cache_gets_total{cache=\"dashboardKpi\"}[5m]))", "legendFormat": "dashboardKpi" },
        { "expr": "sum(rate(cache_gets_total{cache=\"dashboardTrends\"}[5m]))", "legendFormat": "dashboardTrends" }
      ]
    },

    {
      "id": 15,
      "title": "Hits vs Misses (par cache)",
      "type": "timeseries",
      "description": "Comparaison hits (lignes pleines) vs misses (lignes pointillées) cumulés par cache",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "Requêtes", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line",
            "fillOpacity": 10, "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth", "lineWidth": 1, "pointSize": 2,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short", "decimals": 0
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/.*miss.*/" }, "properties": [{ "id": "custom.lineWidth", "value": 2 }] },
          { "matcher": { "id": "byRegexp", "options": "/.*hit.*/" }, "properties": [{ "id": "custom.lineWidth", "value": 2 }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table", "placement": "bottom", "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        { "expr": "rate(cache_gets_total{cache=\"evaluationScores\",result=\"hit\"}[5m])", "legendFormat": "evaluationScores - Hits" },
        { "expr": "rate(cache_gets_total{cache=\"evaluationScores\",result=\"miss\"}[5m])", "legendFormat": "evaluationScores - Misses" },
        { "expr": "rate(cache_gets_total{cache=\"dashboardKpi\",result=\"hit\"}[5m])", "legendFormat": "dashboardKpi - Hits" },
        { "expr": "rate(cache_gets_total{cache=\"dashboardKpi\",result=\"miss\"}[5m])", "legendFormat": "dashboardKpi - Misses" },
        { "expr": "rate(cache_gets_total{cache=\"dashboardTrends\",result=\"hit\"}[5m])", "legendFormat": "dashboardTrends - Hits" },
        { "expr": "rate(cache_gets_total{cache=\"dashboardTrends\",result=\"miss\"}[5m])", "legendFormat": "dashboardTrends - Misses" }
      ]
    },

    {
      "id": 16,
      "title": "État actuel et Détail par Cache",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "id": 17,
      "title": "État des Caches",
      "type": "table",
      "description": "Hit ratio actuel de chaque cache avec statut de santé",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto", "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hit Ratio" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "min", "value": 0 }, { "id": "max", "value": 100 },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null }, { "color": "orange", "value": 50 },
                  { "color": "yellow", "value": 75 }, { "color": "green", "value": 90 }
                ]
              }}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Santé" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-text" },
              { "id": "mappings", "value": [
                { "type": 1, "value": "", "text": "N/A" },
                { "type": 2, "value": "0", "text": "⬜ Aucune donnée", "color": "gray" },
                { "type": 6, "value": "75", "text": "✅ Sain", "color": "green" },
                { "type": 6, "value": "50", "text": "⚠️ Dégradé", "color": "orange" },
                { "type": 6, "value": "0", "text": "❌ Critique", "color": "red" }
              ]}
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum by (cache) (rate(cache_gets_total{result=\"hit\"}[5m])) / sum by (cache) (rate(cache_gets_total[5m])) * 100",
          "legendFormat": "{{cache}}",
          "interval": "",
          "format": "time_series"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "metric": "Cache",
              "Value": "Hit Ratio"
            }
          }
        }
      ]
    },
    {
      "id": 18,
      "title": "Statut par Cache",
      "type": "stat",
      "description": "evaluationScores - hit ratio instantané",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 }, { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent", "min": 0, "max": 100, "decimals": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 27 },
      "options": {
        "colorMode": "background", "graphMode": "sparkline",
        "justifyMode": "auto", "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=\"evaluationScores\",result=\"hit\"}[5m])) / sum(rate(cache_gets_total{cache=\"evaluationScores\"}[5m])) * 100",
          "legendFormat": "evaluationScores"
        }
      ]
    },
    {
      "id": 19,
      "title": "dashboardKpi",
      "type": "stat",
      "description": "dashboardKpi - hit ratio instantané",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
