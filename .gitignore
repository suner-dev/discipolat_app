*.iml
*.iws

# Java
backend/target/
*.class
*.jar
*.war

# Node
node_modules/
dist/
.vite/

# Flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# Docker
docker/volumes/

# Environment
.env
.env.local

# JWT Keys (sensitive - generated locally)
keys/*
!keys/.gitkeep

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Coverage
coverage/
jacoco/

# Docker volumes (local)
pgdata/

# Database dumps (donnees personnelles — ne jamais committer)
backups/

# TypeScript build info
dist-ts/
tsconfig.tsbuildinfo
BOOT-INF

# Fichiers de travail locaux (jamais commités)
token.tmp
*.tmp
app-debug.apk
*.apk

# Resultats de tests navigateur (regenere a chaque execution)
frontend/test-results/
test-results/
playwright-report/

# Large reference documents (keep locally, not in repo)
docs/PRMPT.pdf
docs/PRMPT.txt

# Racine de stockage fichiers pour launches jetables de recette (DISCIPOLAT_FILE_STORAGE_ROOT)
backend/storage-e2e/

# Scripts de recette locaux — contient des MOTS DE PASSE et des chemins de
# cles privees en clair (PGPASSWORD, SPRING_DATASOURCE_PASSWORD, ENCRYPTION_AES_KEY).
# Ne jamais committer : un push les exposerait sur le remote.
*.ps1

# Artefacts d'audit et de recette (logs/erreurs de compil, regeneres a chaque run).
# On NE masque PAS tout `audit/` : les deux inventories de contract y sont
# versionnes volontairement (audit/backend_endpoints.txt,
# audit/frontend_consumed_endpoints.txt) — ce sont des documents de reference.
audit/*
!audit/backend_endpoints.txt
!audit/frontend_consumed_endpoints.txt
*.err
*.log

# Worktrees jetables de recette E2E (base « main-base » détachée, revues comparatives)
.e2e-tmp/
