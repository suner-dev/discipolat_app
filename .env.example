# ══════════════════════════════════════════════════════════════════════════════
# Mobile Money Operator Credentials — Discipolat Payment Gateway
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Sign up for each operator's developer portal (links below)
#   2. Create an app / get sandbox credentials
#   3. Copy this file to .env and fill in your credentials
#   4. Start the backend with the env file loaded
#
# IMPORTANT: Never commit .env to git!
# ══════════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────
# Set to "true" to enable real operator API calls (sandbox or production).
# When "false", payments use local reference generation (no operator API calls).
MOBILEMONEY_ENABLED=false

# ── MTN Mobile Money (MoMo) ─────────────────────────────────────────────────
# Portal:    https://momodeveloper.mtn.com/signup
# Sandbox:   https://sandbox.momodeveloper.mtn.com
# Docs:      https://momodeveloper.mtn.com/get-started
#
# After signup → Products → Collection → Subscribe → get credentials.
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
MTN_WEBHOOK_SECRET=

# ── Orange Money (Web Payment) ───────────────────────────────────────────────
# Portal:    https://developer.orange.com
# Docs:      https://developer.orange.com/apis/om-webpay
# Sandbox:   https://api.orange.com (use sandbox merchant key)
#
# After signup → Products → Orange Money → Subscribe → get API key & merchant key.
ORANGE_API_KEY=
ORANGE_MERCHANT_KEY=
ORANGE_CLIENT_SECRET=
ORANGE_BASE_URL=https://api.orange.com
ORANGE_WEBHOOK_SECRET=
ORANGE_RETURN_URL=http://localhost:5173/giving
ORANGE_NOTIF_URL=

# ── M-Pesa (Safaricom Daraja) ───────────────────────────────────────────────
# Portal:    https://developer.safaricom.co.ke/account/signup
# Docs:      https://developer.safaricom.co.ke/apis
# Sandbox:   https://sandbox.safaricom.co.ke
#
# After signup → Create App → Get consumer key & secret.
# Short code & passkey provided by Safaricom after go-live approval.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_WEBHOOK_SECRET=

# ── Webhook Security ─────────────────────────────────────────────────────────
# Shared secret for the generic webhook endpoint (POST /api/v1/payments/webhook).
# Leave empty to disable the generic webhook endpoint (returns 503).
PAYMENTS_WEBHOOK_SECRET=

# ── Polling Interval ─────────────────────────────────────────────────────────
# How often to check pending payments (especially MTN which has no webhook).
# Default: 30000 (30 seconds)
PAYMENTS_WEBHOOK_POLL_INTERVAL_MS=30000

# ── AI Assistant (Ollama) ────────────────────────────────────────────────────
# Local LLM server. If unreachable, the AI assistant falls back to a
# deterministic contextual engine (the chat always answers).
#   - Local dev:  http://localhost:11434  (default)
#   - Docker:     http://ollama:11434     (if the ollama service is in compose)
OLLAMA_URL=http://localhost:11434
# Model pulled locally via `ollama pull <name>` (llama3, mistral, qwen2.5...)
AI_MODEL=llama3

# ── Payments: sandbox vs simulation ─────────────────────────────────────────
# MOBILEMONEY_ENABLED=true  -> real operator API calls (sandbox/prod creds below)
# MOBILEMONEY_ENABLED=false -> local reference generation only
MOBILEMONEY_ENABLED=false
# Auto-confirm pending payments without a real gateway (beta/dev only).
# 0 = disabled (payments confirmed only by operator webhook).
PAYMENTS_SIMULATE_CONFIRM_DELAY_MS=0

# ── USSD (Africa's Talking) ─────────────────────────────────────────────────
# Portal:    https://africastalking.com
# Docs:      https://developers.africastalking.com/docs/ussd/overview
# Sandbox:   https://api.sandbox.africastalking.com
#
# After signup → Create App → Get API Key → Register USSD Service Code.
# Le callback URL doit être configuré dans le dashboard Africa's Talking :
#   https://your-domain.com/api/v1/ussd/callback
#
# Set to "true" to enable the USSD gateway (requires valid credentials below).
APP_USSD_ENABLED=false
APP_USSD_API_KEY=
APP_USSD_USERNAME=
APP_USSD_SERVICE_CODE=
APP_USSD_BASE_URL=https://api.africastalking.com
APP_USSD_WEBHOOK_SECRET=
APP_USSD_CALLBACK_URL=

# ── Speech (STT/TTS) ────────────────────────────────────────────────────────
# STT (Speech-to-Text) — Whisper API (OpenAI-compatible)
# Provider:  https://platform.openai.com/docs/guides/speech-to-text
# Docs:      https://api.openai.com/v1/audio/transcriptions
#
# After signup → API Keys → Create API key → set below.
APP_SPEECH_API_URL=https://api.openai.com/v1
APP_SPEECH_API_KEY=
APP_SPEECH_MODEL=whisper-1

# TTS (Text-to-Speech) — OpenAI TTS API (compatible)
# Provider:  https://platform.openai.com/docs/guides/text-to-speech
# Docs:      https://api.openai.com/v1/audio/speech
#
# After signup → API Keys → Create API key → set below.
APP_TTS_API_URL=https://api.openai.com/v1
APP_TTS_API_KEY=
APP_TTS_MODEL=tts-1
APP_TTS_VOICE=alloy
