# ============================================
# Discipolat — Configuration d'environnement
# ============================================
# Copier ce fichier vers .env et adapter les valeurs
# cp .env.example .env

# --- Base de données ---
POSTGRES_DB=discipolat
POSTGRES_USER=discipolat
POSTGRES_PASSWORD=discipolat_secret

# --- Clés JWT (RSA 2048 bits) ---
# En local (fichier) :
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
#
# Sur Render (base64 encodées) :
# JWT_PRIVATE_KEY=<base64 de private.pem>
# JWT_PUBLIC_KEY=<base64 de public.pem>

# --- Profil Spring ---
SPRING_PROFILES_ACTIVE=docker

# --- URLs ---
FRONTEND_URL=http://localhost:3000,http://localhost:5173
FRONTEND_URL_BASE=http://localhost:5173

# --- Mail (optionnel) ---
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
