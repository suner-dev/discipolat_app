# ══════════════════════════════════════════════════════════════════════════════
# Mobile Money Operator Credentials — Discipolat Payment Gateway
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Sign up for each operator's developer portal (links below)
#   2. Create an app / get sandbox credentials
#   3. Copy this file to .env and fill in your credentials
#   4. Start the backend with the env file loaded
#
# IMPORTANT: Never commit .env to git!
# ══════════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────
# Set to "true" to enable real operator API calls (sandbox or production).
# When "false", payments use local reference generation (no operator API calls).
MOBILEMONEY_ENABLED=false

# ── MTN Mobile Money (MoMo) ─────────────────────────────────────────────────
# Portal:    https://momodeveloper.mtn.com/signup
# Sandbox:   https://sandbox.momodeveloper.mtn.com
# Docs:      https://momodeveloper.mtn.com/get-started
#
# After signup → Products → Collection → Subscribe → get credentials.
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
MTN_WEBHOOK_SECRET=

# ── Orange Money (Web Payment) ───────────────────────────────────────────────
# Portal:    https://developer.orange.com
# Docs:      https://developer.orange.com/apis/om-webpay
# Sandbox:   https://api.orange.com (use sandbox merchant key)
#
# After signup → Products → Orange Money → Subscribe → get API key & merchant key.
ORANGE_API_KEY=
ORANGE_MERCHANT_KEY=
ORANGE_BASE_URL=https://api.orange.com
ORANGE_WEBHOOK_SECRET=
ORANGE_RETURN_URL=http://localhost:5173/giving
ORANGE_NOTIF_URL=

# ── M-Pesa (Safaricom Daraja) ───────────────────────────────────────────────
# Portal:    https://developer.safaricom.co.ke/account/signup
# Docs:      https://developer.safaricom.co.ke/apis
# Sandbox:   https://sandbox.safaricom.co.ke
#
# After signup → Create App → Get consumer key & secret.
# Short code & passkey provided by Safaricom after go-live approval.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_WEBHOOK_SECRET=

# ── Webhook Security ─────────────────────────────────────────────────────────
# Shared secret for the generic webhook endpoint (POST /api/v1/payments/webhook).
# Leave empty to disable the generic webhook endpoint (returns 503).
PAYMENTS_WEBHOOK_SECRET=

# ── Polling Interval ─────────────────────────────────────────────────────────
# How often to check pending payments (especially MTN which has no webhook).
# Default: 30000 (30 seconds)
PAYMENTS_WEBHOOK_POLL_INTERVAL_MS=30000
